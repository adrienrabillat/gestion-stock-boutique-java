<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.womenshop.controllers.MainController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f4f4f4; -fx-padding: 15;">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="WomenShop Manager" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" /> <VBox alignment="CENTER_RIGHT">
                <Label text="Capital Actuel:" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblCapital" text="0.0 €" textFill="green"/>
            </VBox>
                <VBox alignment="CENTER_RIGHT">
                    <Label text="Revenus (Income):"/>
                    <Label fx:id="lblIncome" text="0.0 €"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT">
                    <Label text="Coûts (Costs):"/>
                    <Label fx:id="lblCost" text="0.0 €" textFill="red"/>
                </VBox>
            </HBox>

            <Separator />

            <HBox spacing="10">
                <Button text="Ajouter Produit" onAction="#handleAddProduct" style="-fx-base: #4CAF50;"/>
                <Button text="Modifier Sélection" onAction="#handleModifyProduct"/>
                <Button text="Supprimer Sélection" onAction="#handleDeleteProduct" style="-fx-base: #F44336;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Vendre Item" onAction="#handleSell"/>
                <Button text="Acheter Item" onAction="#handlePurchase"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Soldes ON (-%)" onAction="#handleApplyDiscount" style="-fx-text-fill: blue;"/>
                <Button text="Soldes OFF" onAction="#handleStopDiscount"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #eaeaea;" prefWidth="200">
            <Label text="Filtrer par Catégorie" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="categoryFilter" prefWidth="180"/>

            <Separator />

            <Label text="Trier par Prix" style="-fx-font-weight: bold;"/>
            <Button text="Prix Croissant (↑)" onAction="#handleSortAsc" maxWidth="Infinity"/>
            <Button text="Prix Décroissant (↓)" onAction="#handleSortDesc" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <TableView fx:id="productTable">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colName" text="Nom Produit" prefWidth="200"/>
                <TableColumn fx:id="colCategory" text="Catégorie" prefWidth="100"/>
                <TableColumn fx:id="colPurchasePrice" text="Prix Achat" prefWidth="100"/>
                <TableColumn fx:id="colSellPrice" text="Prix Vente" prefWidth="100"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

</BorderPane>