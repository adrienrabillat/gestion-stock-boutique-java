<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.womenshop.controllers.ProductFormController"
      style="-fx-padding: 20; -fx-background-color: white;">

    <Label text="Détails du Produit" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Catégorie:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboCategory" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nom:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Prix Achat:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPurchasePrice" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Prix Vente:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSellPrice" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Stock Initial:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtStock" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator />

    <Label text="Caractéristiques Spécifiques" style="-fx-font-weight: bold;"/>
    <VBox fx:id="specificFieldsContainer" spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;">
        <Label text="Sélectionnez une catégorie..." textFill="gray"/>
    </VBox>

    <Separator />

    <HBox spacing="15" alignment="CENTER">
        <Button text="Enregistrer" onAction="#handleSave" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>

</VBox>